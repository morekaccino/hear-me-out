<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and higher backup and device-transfer rules.

  path_provider resolves getApplicationSupportDirectory() to filesDir on
  Android, and mediaStoreProvider appends mediaDirectoryName ("media").
  Excluding domain="file" path="media/" covers filesDir/media for both cloud
  backup and direct device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="media/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="media/" />
    </device-transfer>
</data-extraction-rules>

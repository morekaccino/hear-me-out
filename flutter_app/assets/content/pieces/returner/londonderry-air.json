  "authoring": {
    "author": "Hear Me Out content team",
    "source": "Traditional melody after the F major Danny Boy setting in Paul Hardy's Songs Tunebook, transposed up a whole tone to G and reduced to the vocal line. Weatherly's lyric is not used.",
    "reviewedBy": "Pending musical review",
    "notes": "13 bars in 4/4 with a two-beat pickup. The first two phrases are in first position; the B-section lift moves to second position (E5 on string 2 fret 5), then phrase 4 returns to first position: two hand shifts. The low E4 and F#4 are melody notes on string 4, not a bass voice.",
    "kind": "piece",
    "tier": "returner",
    "stage": 5
  }
}

  "authoring": {
    "author": "Hear Me Out content team",
    "source": "Single-line melody after the public-domain Mutopia guitar edition. The opening phrase is transposed down one octave to fit first position; the answering phrase stays at its written octave. No left-hand bass or second voice is used.",
    "reviewedBy": "Pending musical review",
    "notes": "First 16-bar section only, in 3/4, melody only. The opening phrase (bars 1-4 and its repeat) is transposed down one octave because it exceeds the V1 first-position range; the answering phrase (bars 5-8 and its repeat) is left at pitch. The written range is C4-D5 and every note is in first position. The T3.1 planning note says strings 1-3, but the authentic two-register melody needs strings 2-5; no bass voice is added.",
    "kind": "piece",
    "tier": "returner",
    "stage": 9
  }
